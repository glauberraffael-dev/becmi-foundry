    </div>

    {{#if (eq crafting.inputs.mode "armor")}}
    <div class="becmi-grid becmi-grid--combat">
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.priceGp'}}:</label><input data-crafting-input="priceGp" type="number" min="0" value="{{crafting.inputs.priceGp}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.encumbranceCn'}}:</label><input data-crafting-input="encumbranceCn" type="number" min="0" value="{{crafting.inputs.encumbranceCn}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.bonuses'}}:</label><input data-crafting-input="bonuses" type="number" min="1" max="5" value="{{crafting.inputs.bonuses}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.opponentBonuses'}}:</label><input data-crafting-input="opponentBonuses" type="number" min="0" max="5" value="{{crafting.inputs.opponentBonuses}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.restrictions'}}:</label><input data-crafting-input="restrictions" type="number" min="0" max="10" value="{{crafting.inputs.restrictions}}"></div>
    </div>
    {{/if}}
    {{#if (eq crafting.inputs.mode "weapon")}}
    <div class="becmi-grid becmi-grid--combat">
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.priceGp'}}:</label><input data-crafting-input="priceGp" type="number" min="0" value="{{crafting.inputs.priceGp}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.encumbranceCn'}}:</label><input data-crafting-input="encumbranceCn" type="number" min="0" value="{{crafting.inputs.encumbranceCn}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.bonuses'}}:</label><input data-crafting-input="bonuses" type="number" min="1" max="5" value="{{crafting.inputs.bonuses}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.opponentBonuses'}}:</label><input data-crafting-input="opponentBonuses" type="number" min="0" max="5" value="{{crafting.inputs.opponentBonuses}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.restrictions'}}:</label><input data-crafting-input="restrictions" type="number" min="0" max="10" value="{{crafting.inputs.restrictions}}"></div>
    </div>
    {{/if}}
    {{#if (eq crafting.inputs.mode "miscellaneous")}}
    <div class="becmi-grid becmi-grid--combat">
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.spellLevel'}}:</label><input data-crafting-input="spellLevel" type="number" min="1" max="9" value="{{crafting.inputs.spellLevel}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.spellLevels'}}:</label><input data-crafting-input="spellLevels" type="number" min="1" value="{{crafting.inputs.spellLevels}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.charges'}}:</label><input data-crafting-input="charges" type="number" min="0" value="{{crafting.inputs.charges}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.restrictions'}}:</label><input data-crafting-input="restrictions" type="number" min="0" max="10" value="{{crafting.inputs.restrictions}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.usesPerPeriod'}}:</label>
        <select data-crafting-input="usesPerPeriod">
          {{#each crafting.periodOptions as |option|}}
          <option value="{{option.key}}"{{#if (eq option.key ../crafting.inputs.usesPerPeriod)}} selected{{/if}}>{{option.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.usesPerPeriodCount'}}:</label><input data-crafting-input="usesPerPeriodCount" type="number" min="0" value="{{crafting.inputs.usesPerPeriodCount}}"></div>
      <label class="becmi-check"><input type="checkbox" data-crafting-input="permanent"{{#if crafting.inputs.permanent}} checked{{/if}}> {{localize 'BECMI.crafting.permanent'}}</label>
      <label class="becmi-check"><input type="checkbox" data-crafting-input="nonRechargeable"{{#if crafting.inputs.nonRechargeable}} checked{{/if}}> {{localize 'BECMI.crafting.nonRechargeable'}}</label>
    </div>
    {{/if}}
    {{#if (eq crafting.inputs.mode "construct")}}
    <div class="becmi-grid becmi-grid--combat">
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.hitDice'}}:</label><input data-crafting-input="hitDice" type="number" min="1" max="36" value="{{crafting.inputs.hitDice}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.asterisks'}}:</label><input data-crafting-input="asterisks" type="number" min="0" value="{{crafting.inputs.asterisks}}"></div>
    </div>
    {{/if}}
    {{#if (eq crafting.inputs.mode "research")}}
    <div class="becmi-grid becmi-grid--combat">
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.spellLevel'}}:</label><input data-crafting-input="spellLevel" type="number" min="1" max="9" value="{{crafting.inputs.spellLevel}}"></div>
      <div class="becmi-field"><label>{{localize 'BECMI.crafting.failures'}}:</label><input data-crafting-input="failures" type="number" min="0" value="{{crafting.inputs.failures}}"></div>
      <label class="becmi-check"><input type="checkbox" data-crafting-input="newSpell"{{#if crafting.inputs.newSpell}} checked{{/if}}> {{localize 'BECMI.crafting.newSpell'}}</label>
    </div>
    {{/if}}
    <div class="becmi-grid becmi-grid--combat">
      <button type="button" class="becmi-roll" data-action="rollCrafting">{{localize 'BECMI.crafting.check'}}</button>
    </div>
  </div>
</section>

</div>

<!-- ============================ SIDEBAR ============================ -->
<aside class="becmi-sidebar" aria-label="{{localize 'BECMI.sheet.sidebar.title'}}">
  <div class="becmi-section-title">{{localize 'BECMI.sheet.sidebar.title'}}
    <button type="button" class="becmi-roll" data-action="toggleSidebar">×</button>
  </div>

  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.sidebar.quickRolls'}}</h3>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.targetAC'}}:</label>
    <button type="button" class="becmi-roll{{#if targetAcAuto}} is-active{{/if}}" data-action="toggleTargetAcAuto" aria-pressed="{{targetAcAuto}}" title="{{localize 'BECMI.labels.targetAcAuto'}}">{{localize 'BECMI.labels.targetAcAuto'}}</button>
    <input data-target-ac type="number" value="{{targetAC}}" min="-10" max="20" {{#if targetAcAuto}}disabled{{/if}}></div>
  <div class="becmi-sidebar-roll">
    <input type="text" data-roll-expression value="1d20" aria-label="{{localize 'BECMI.sheet.expression'}}">
    <button type="button" class="becmi-roll" data-action="rollFree">{{localize 'BECMI.sheet.roll'}}</button>
  </div>
  <div class="becmi-sidebar-dice">
    {{#each diceOptions as |die|}}
    <button type="button" class="becmi-roll" data-action="rollDice" data-dice="{{die.faces}}">d{{die.faces}}</button>
    {{/each}}
  </div>

  {{#if isCharacter}}
  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.sidebar.classInfo'}}</h3>
  <p class="becmi-hint">{{className}}</p>
  {{#each classResources as |resource|}}
  <p class="becmi-hint">{{resource.label}}</p>
  {{/each}}
  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.sidebar.abilities'}}</h3>
  <div class="becmi-scroll-y becmi-feature-list">
    {{#each classFeatures as |feature|}}
    <p class="becmi-hint"><strong>{{feature.label}}</strong>{{#if feature.unlocked}} ✓{{else}} ({{feature.requirement}}){{/if}} — {{feature.detail}}</p>
    {{else}}
    <p class="becmi-hint">{{localize 'BECMI.sheet.noFeatures'}}</p>
    {{/each}}
  </div>
  {{#if classKey}}
  {{#if (eq classKey "cleric")}}
  <button type="button" class="becmi-roll" data-action="toggleDruid">
    {{#if isDruid}}{{localize 'BECMI.sheet.druidDisable'}}{{else}}{{localize 'BECMI.sheet.druidEnable'}}{{/if}}
  </button>
  {{/if}}
  {{/if}}
  {{#each milestones as |milestone|}}
  <p class="becmi-hint">• {{milestone}}</p>
  {{/each}}

  <h3 class="becmi-subtitle">{{localize 'BECMI.labels.languages'}}</h3>
  <input name="system.languages" type="text" value="{{system.languages}}" {{#unless editable}}disabled{{/unless}}>
  <h3 class="becmi-subtitle">{{localize 'BECMI.labels.specialAbilities'}}</h3>
  <textarea class="becmi-editor" name="system.specialAbilities" {{#unless editable}}disabled{{/unless}}>{{system.specialAbilities}}</textarea>
  {{/if}}

  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.sidebar.reference'}}</h3>
  <div class="becmi-sidebar-links">
    {{#if isCharacter}}<button type="button" class="becmi-roll" data-action="switchTab" data-tab="attack">{{localize 'BECMI.sheet.tab.attack'}}</button>{{/if}}
    {{#if canTurn}}<button type="button" class="becmi-roll" data-action="switchTab" data-tab="undead">{{localize 'BECMI.sheet.tab.undead'}}</button>{{/if}}
    {{#if canMastery}}<button type="button" class="becmi-roll" data-action="switchTab" data-tab="mastery">{{localize 'BECMI.sheet.tab.mastery'}}</button>{{/if}}
    {{#if isCharacter}}<button type="button" class="becmi-roll" data-action="toggleMastery">{{masteryToggleLabel}}</button>{{/if}}
    {{#if canGeneral}}<button type="button" class="becmi-roll" data-action="switchTab" data-tab="general">{{localize 'BECMI.sheet.tab.general'}}</button>{{/if}}
    {{#if isCharacter}}<button type="button" class="becmi-roll" data-action="toggleGeneral">{{generalToggleLabel}}</button>{{/if}}
    <button type="button" class="becmi-roll" data-action="switchTab" data-tab="notes">{{localize 'BECMI.sheet.tab.notes'}}</button>
  </div>
</aside>
</div>
</div>
