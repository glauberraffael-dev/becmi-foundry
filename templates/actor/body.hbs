<div class="becmi-body">
<nav class="becmi-tabs" aria-label="{{localize 'BECMI.sheet.tabs'}}">
  {{#each tabs as |tab|}}
  <button type="button" class="becmi-tab{{#if tab.active}} is-active{{/if}}" data-action="switchTab" data-tab="{{tab.id}}">{{tab.label}}</button>
  {{/each}}
  <button type="button" class="becmi-tab becmi-tab--sidebar" data-action="toggleSidebar">{{sidebarToggleLabel}}</button>
</nav>

<div class="becmi-layout{{#if sidebarCollapsed}} is-collapsed{{/if}}">
<div class="becmi-panels">

{{#if isCharacter}}
<!-- ============================ MAIN ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "main")}} is-active{{/if}}" data-tab="main">
  <div class="becmi-main-grid">
    <div class="becmi-column">
      <h2 class="becmi-section-title">{{localize 'BECMI.sheet.attributes'}}</h2>
      <table class="becmi-table becmi-table--attributes">
        <thead><tr><th></th><th>{{localize 'BECMI.sheet.score'}}</th><th>{{localize 'BECMI.sheet.extra'}}</th><th>{{localize 'BECMI.sheet.adjustment'}}</th><th></th></tr></thead>
        <tbody>
          {{#each abilityRows as |ability|}}
          <tr>
            <th>{{ability.label}}</th>
            <td><input name="system.abilities.{{ability.key}}.value" type="number" value="{{ability.value}}" {{#unless ../editable}}disabled{{/unless}}></td>
            <td><input name="system.abilities.{{ability.key}}.bonus" type="number" value="{{ability.bonus}}" {{#unless ../editable}}disabled{{/unless}}></td>
            <td class="becmi-derived">{{ability.adjustment}}</td>
            <td><button type="button" class="becmi-roll" data-action="rollAbility" data-ability="{{ability.key}}">{{localize 'BECMI.sheet.roll'}}</button></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <h2 class="becmi-section-title">{{localize 'BECMI.sheet.creation'}}</h2>
      <div class="becmi-combat-fields">
        <button type="button" class="becmi-roll" data-action="createCharacter" {{#unless editable}}disabled{{/unless}}>{{localize 'BECMI.sheet.createCharacter'}}</button>
        <button type="button" class="becmi-roll" data-action="levelUp" {{#unless editable}}disabled{{/unless}}>{{localize 'BECMI.sheet.levelUp'}}</button>
      </div>
      {{#if rcClass}}
      <p class="becmi-hint">{{rcClass.name}} — {{localize 'BECMI.labels.hd'}} 1d{{rcClass.hitDie}}, {{localize 'BECMI.labels.maxLevel'}} {{rcClass.maxLevel}}.</p>
      {{/if}}
    </div>

    <div class="becmi-column">
      <h2 class="becmi-section-title">{{localize 'BECMI.sheet.combatSaves'}}</h2>
      <div class="becmi-grid becmi-grid--combat">
        <div class="becmi-field"><label>{{localize 'BECMI.labels.ac'}}:</label><span class="becmi-derived">{{system.attributes.ac.value}}</span></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.armorType'}}:</label>
          <select name="system.attributes.armor.type" {{#unless editable}}disabled{{/unless}}>
            {{#each armorOptions as |option|}}
            <option value="{{option.key}}" {{#if (eq option.key ../system.attributes.armor.type)}}selected{{/if}}>{{option.name}} ({{option.ac}})</option>
            {{/each}}
          </select>
        </div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.magicBonus'}}:</label><input name="system.attributes.armor.magicBonus" type="number" value="{{system.attributes.armor.magicBonus}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.shield'}}:</label><input name="system.attributes.armor.shield" type="checkbox" {{#if system.attributes.armor.shield}}checked{{/if}} {{#unless editable}}disabled{{/unless}}></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.shieldMagic'}}:</label><input name="system.attributes.armor.shieldMagic" type="number" value="{{system.attributes.armor.shieldMagic}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="becmi-field becmi-field--hp">
          <label>{{localize 'BECMI.labels.hp'}}:</label>
          <input class="becmi-hp-current" name="system.attributes.hp.value" type="number" min="0" value="{{system.attributes.hp.value}}" title="{{localize 'BECMI.sheet.hpCurrentHint'}}">
          <span class="becmi-hp-divider">/</span>
          <input name="system.attributes.hp.max" type="number" min="0" value="{{system.attributes.hp.max}}" {{#unless editable}}disabled{{/unless}}>
        </div>
        <div class="becmi-field becmi-field--hp-bar">
          <div class="becmi-hp-bar" role="meter" aria-valuemin="0" aria-valuemax="{{hpBar.max}}" aria-valuenow="{{hpBar.value}}"><span style="width: {{hpBar.percent}}%"></span></div>
        </div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.thac0'}}:</label><input name="system.attributes.thac0" type="number" value="{{system.attributes.thac0}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.attackColumn'}}:</label><span class="becmi-derived">{{attackSpec}}</span></div>
      </div>
      <p class="becmi-hint">{{attackLabel}}</p>
      <div class="becmi-combat-fields">
        <button type="button" class="becmi-roll" data-action="rollInitiative">{{localize 'BECMI.rolls.initiative'}} (d6)</button>
        <button type="button" class="becmi-roll" data-action="rollMorale">{{localize 'BECMI.rolls.morale'}} (2d6)</button>
        <button type="button" class="becmi-roll" data-action="rollHitDice">{{localize 'BECMI.rolls.hitDice'}}</button>
      </div>
      <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.savingThrows'}}</h3>
      <div class="becmi-saves-scroll">
      <table class="becmi-table becmi-table--saves">
        <thead><tr><th>{{localize 'BECMI.sheet.skill'}}</th><th>{{localize 'BECMI.labels.saveBase'}}</th><th>{{localize 'BECMI.labels.saveAuto'}}</th><th>{{localize 'BECMI.labels.saveMod'}}</th><th>{{localize 'BECMI.labels.saveTarget'}}</th><th></th></tr></thead>
        <tbody>
          {{#each saveRows as |save|}}
          <tr>
            <th>{{save.label}}</th>
            <td><input name="system.saveDetail.{{save.key}}.base" type="number" value="{{save.base}}" {{#unless ../editable}}disabled{{/unless}}></td>
            <td><input name="system.saveDetail.{{save.key}}.auto" type="number" value="{{save.auto}}" {{#unless ../editable}}disabled{{/unless}}></td>
            <td><input name="system.saveDetail.{{save.key}}.mod" type="number" value="{{save.mod}}" {{#unless ../editable}}disabled{{/unless}}></td>
            <td class="becmi-derived">{{save.target}}</td>
            <td><button type="button" class="becmi-roll" data-action="rollSave" data-save="{{save.key}}">{{localize 'BECMI.sheet.roll'}}</button></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      </div>
    </div>

    <div class="becmi-column">
      <h2 class="becmi-section-title">{{localize 'BECMI.sheet.equipmentEncumbrance'}}</h2>
      <div class="becmi-grid becmi-grid--combat">
        <div class="becmi-field"><label>{{localize 'BECMI.labels.armorWeight'}}:</label><span class="becmi-derived">{{system.attributes.load.armor}}</span></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.shieldWeight'}}:</label><span class="becmi-derived">{{system.attributes.load.shield}}</span></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.coinsWeight'}}:</label><span class="becmi-derived">{{system.attributes.load.coins}}</span></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.equipmentWeight'}}:</label><input name="system.attributes.load.equipment" type="number" value="{{system.attributes.load.equipment}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.gems'}}:</label><input name="system.attributes.load.gems" type="number" value="{{system.attributes.load.gems}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.jewels'}}:</label><input name="system.attributes.load.jewels" type="number" value="{{system.attributes.load.jewels}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.weaponsWeight'}}:</label><input name="system.attributes.load.weapons" type="number" value="{{system.attributes.load.weapons}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="becmi-field"><label>{{localize 'BECMI.sheet.encumbrance'}}:</label><span class="becmi-derived">{{system.attributes.load.total}}</span></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.movementTurn'}}:</label><span class="becmi-derived">{{system.attributes.load.movementTurn}}</span></div>
        <div class="becmi-field"><label>{{localize 'BECMI.labels.movementRound'}}:</label><span class="becmi-derived">{{system.attributes.load.movementRound}}</span></div>
      </div>
      <h2 class="becmi-section-title">{{localize 'BECMI.sheet.coins'}}</h2>
      <div class="becmi-coins">
        <label>PP:</label><input name="system.attributes.gold.pp" type="number" value="{{system.attributes.gold.pp}}" {{#unless editable}}disabled{{/unless}}>
        <label>GP:</label><input name="system.attributes.gold.gp" type="number" value="{{system.attributes.gold.gp}}" {{#unless editable}}disabled{{/unless}}>
        <label>EP:</label><input name="system.attributes.gold.ep" type="number" value="{{system.attributes.gold.ep}}" {{#unless editable}}disabled{{/unless}}>
        <label>SP:</label><input name="system.attributes.gold.sp" type="number" value="{{system.attributes.gold.sp}}" {{#unless editable}}disabled{{/unless}}>
        <label>CP:</label><input name="system.attributes.gold.cp" type="number" value="{{system.attributes.gold.cp}}" {{#unless editable}}disabled{{/unless}}>
      </div>
    </div>
  </div>
</section>

<!-- ============================ CLASS FEATURES ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "features")}} is-active{{/if}}" data-tab="features">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.tab.features'}}</h2>
  <p class="becmi-hint">{{className}}{{#if classKey}} — {{localize 'BECMI.labels.level'}} {{level}} / {{localize 'BECMI.labels.xp'}} {{xp}}{{/if}}</p>
  <div class="becmi-feature-grid becmi-scroll-y">
    {{#each classFeatures as |feature|}}
    <article class="becmi-feature{{#unless feature.unlocked}} is-locked{{/unless}}">
      <h3 class="becmi-subtitle">{{feature.label}}{{#if feature.requirement}} <small>({{feature.requirement}})</small>{{/if}}</h3>
      <p>{{feature.detail}}</p>
      <p class="becmi-hint">{{#if feature.unlocked}}{{localize 'BECMI.sheet.featureUnlocked'}}{{else}}{{localize 'BECMI.sheet.featureLocked'}}{{/if}}</p>
    </article>
    {{else}}
    <p class="becmi-empty">{{localize 'BECMI.sheet.noFeatures'}}</p>
    {{/each}}
  </div>
</section>

<!-- ============================ EQUIPMENT ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "equipment")}} is-active{{/if}}" data-tab="equipment">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.equipment'}} <button type="button" class="becmi-roll" data-action="addItem">+</button></h2>
  {{#each equipmentGroups as |group|}}
  <h3 class="becmi-subtitle">{{group.label}}</h3>
  <table class="becmi-table becmi-table--equipment">
    <thead><tr><th>{{localize 'BECMI.labels.name'}}</th><th>{{localize 'BECMI.labels.cost'}}</th><th>{{localize 'BECMI.labels.weight'}}</th><th>{{localize 'BECMI.labels.quantity'}}</th><th>{{localize 'BECMI.sheet.actions'}}</th></tr></thead>
    <tbody>
      {{#each group.items as |item|}}
      <tr>
        <th><button type="button" class="becmi-item-name" data-action="itemOpen" data-item-id="{{item.id}}">{{item.name}}</button></th>
        <td>{{item.cost}}</td><td>{{item.weight}}</td><td>{{item.quantity}}</td>
        <td class="becmi-actions">
          {{#if (eq item.type "weapon")}}
          <button type="button" class="becmi-roll" data-action="itemAttack" data-item-id="{{item.id}}">{{localize 'BECMI.rolls.attack'}}</button>
          <button type="button" class="becmi-roll" data-action="itemDamage" data-item-id="{{item.id}}">{{localize 'BECMI.rolls.damage'}}</button>
          {{/if}}
          {{#if item.rollFormula}}<button type="button" class="becmi-roll" data-action="itemFormula" data-item-id="{{item.id}}">{{localize 'BECMI.rolls.formula'}}</button>{{/if}}
          <button type="button" class="becmi-roll" data-action="itemDelete" data-item-id="{{item.id}}">×</button>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="5" class="becmi-empty">{{localize 'BECMI.sheet.empty'}}</td></tr>
      {{/each}}
    </tbody>
  </table>
  {{/each}}
</section>

<!-- ============================ SPELLS ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "spells")}} is-active{{/if}}" data-tab="spells">
  {{#if canCast}}
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.spellsPerDay'}}</h2>
  <table class="becmi-table becmi-table--slot-bars">
    <thead><tr><th>{{localize 'BECMI.labels.spellLevel'}}</th><th>{{localize 'BECMI.sheet.preparedSlots'}}</th><th>{{localize 'BECMI.sheet.available'}}</th></tr></thead>
    <tbody>
      {{#each spellGroups as |group|}}
      <tr>
        <th>{{group.level}}</th>
        <td>{{group.prepared}}/{{group.max}}</td>
        <td><div class="becmi-slot-bar" role="meter" aria-valuemin="0" aria-valuemax="{{group.max}}" aria-valuenow="{{group.remaining}}"><span style="width: {{group.percent}}%"></span></div><small>{{group.remaining}}</small></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  <div class="becmi-combat-fields">
    <button type="button" class="becmi-roll" data-action="restSpells">{{localize 'BECMI.sheet.rest'}}</button>
    {{#if isDruid}}<button type="button" class="becmi-roll" data-action="toggleDruid">{{localize 'BECMI.sheet.druidDisable'}}</button>{{/if}}
  </div>

  {{#each spellGroups as |group|}}
  <section class="becmi-spell-level">
    <h3 class="becmi-subtitle">{{localize 'BECMI.labels.spellLevel'}} {{group.level}} — {{group.prepared}}/{{group.max}}</h3>
    {{#if group.max}}
    <table class="becmi-table becmi-table--memorized">
      <thead><tr><th>#</th><th>{{localize 'BECMI.item.spell'}}</th><th>{{localize 'BECMI.sheet.used'}}</th><th>{{localize 'BECMI.sheet.actions'}}</th></tr></thead>
      <tbody>
        {{#each group.entries as |entry|}}
        <tr>
          <td>{{entry.number}}</td>
          <td><select name="system.spellbook.memorized.{{entry.key}}" {{#unless ../editable}}disabled{{/unless}}>
            <option value="">—</option>
            {{#each entry.options as |option|}}
            <option value="{{option.key}}" {{#if (eq option.key entry.spell)}}selected{{/if}}>{{option.name}}</option>
            {{/each}}
          </select></td>
          <td><input type="checkbox" name="system.spellbook.used.{{entry.key}}" {{#if entry.used}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}}></td>
          <td>{{#if entry.spell}}<button type="button" class="becmi-roll" data-action="castSpell" data-slot="{{entry.key}}" data-spell-key="{{entry.spell}}" data-item-id="{{entry.itemId}}">{{localize 'BECMI.rolls.cast'}}</button>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="becmi-hint">{{localize 'BECMI.sheet.noSlotsAtLevel'}}</p>
    {{/if}}
  </section>
  {{/each}}

  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.grimoire'}}</h3>
  <textarea class="becmi-editor" name="system.spellbook.grimoire" {{#unless editable}}disabled{{/unless}}>{{grimoire}}</textarea>

  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.importSpell'}}</h3>
  <p class="becmi-hint">{{localize 'BECMI.sheet.importHint'}}</p>
  <div class="becmi-import-row">
    <select multiple size="7" data-spell-import {{#unless editable}}disabled{{/unless}}>
      {{#each importSpellOptions as |spell|}}
      <option value="{{spell.uuid}}" {{#if spell.known}}disabled{{/if}}>{{localize 'BECMI.labels.level'}} {{spell.level}} · {{spell.list}} · {{spell.name}}{{#if spell.known}} ({{localize 'BECMI.sheet.known'}}){{/if}}</option>
      {{/each}}
    </select>
    <button type="button" class="becmi-roll" data-action="importSpell" {{#unless editable}}disabled{{/unless}}>{{localize 'BECMI.sheet.importSelected'}}</button>
  </div>

  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.spellList'}}</h3>
  <div class="becmi-filter-row">
    <input type="number" name="spellFilterLevel" value="{{spellFilterLevel}}" min="0" max="9" placeholder="{{localize 'BECMI.labels.spellLevel'}}">
    <input type="text" name="spellSearch" value="{{spellSearch}}" placeholder="{{localize 'BECMI.sheet.search'}}">
  </div>
  <div class="becmi-filter-row">
    {{#each spellFilterOptions as |option|}}
    <button type="button" class="becmi-roll{{#if (eq option.key ../spellListFilter)}} is-active{{/if}}" data-action="setSpellList" data-list="{{option.key}}">{{option.name}}</button>
    {{/each}}
  </div>
  <table class="becmi-table becmi-table--spells">
    <thead><tr><th>{{localize 'BECMI.sheet.spellListColumn'}}</th><th>{{localize 'BECMI.labels.spellLevel'}}</th><th>{{localize 'BECMI.item.spell'}}</th><th>{{localize 'BECMI.labels.range'}}</th><th>{{localize 'BECMI.labels.duration'}}</th><th>{{localize 'BECMI.labels.effect'}}</th><th>{{localize 'BECMI.labels.notes'}}</th><th></th></tr></thead>
    <tbody>
      {{#each spellList as |spell|}}
      <tr>
        <td>{{spell.listName}}</td><td>{{spell.level}}</td><th>{{spell.name}}</th><td>{{spell.range}}</td><td>{{spell.duration}}</td><td>{{spell.effect}}</td><td>{{spell.notes}}</td>
        <td><button type="button" class="becmi-roll" data-action="memorizeSpell" data-spell-key="{{spell.key}}" data-item-id="{{spell.itemId}}" {{#unless ../editable}}disabled{{/unless}}>+</button></td>
      </tr>
      {{else}}
      <tr><td colspan="8" class="becmi-empty">{{localize 'BECMI.sheet.empty'}}</td></tr>
      {{/each}}
    </tbody>
  </table>
  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.classSpells'}} — {{className}}</h3>
  <p class="becmi-hint">{{localize 'BECMI.sheet.spellDropHint'}}</p>
  <ul class="becmi-items">
    {{#each classSpells as |item|}}
    <li class="becmi-item">
      <span class="becmi-badge">{{item.level}}</span>
      <button type="button" class="becmi-item-name" data-action="itemOpen" data-item-id="{{item.id}}">{{item.name}}</button>
      <button type="button" class="becmi-roll" data-action="itemCast" data-item-id="{{item.id}}">{{localize 'BECMI.rolls.cast'}}</button>
      {{#if item.rollFormula}}<button type="button" class="becmi-roll" data-action="itemFormula" data-item-id="{{item.id}}">{{localize 'BECMI.rolls.formula'}}</button>{{/if}}
      <button type="button" class="becmi-roll" data-action="itemDelete" data-item-id="{{item.id}}">×</button>
    </li>
    {{/each}}
  </ul>
  {{#if editable}}<button type="button" class="becmi-roll" data-action="addItem">{{localize 'BECMI.sheet.addSpell'}}</button>{{/if}}
  {{else}}
  <p class="becmi-hint">{{localize 'BECMI.notification.noSpells'}}</p>
  {{/if}}
</section>

<!-- ============================ THIEF ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "thief")}} is-active{{/if}}" data-tab="thief">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.thiefSkills'}}</h2>
  <table class="becmi-table becmi-table--skills">
    <thead><tr><th>{{localize 'BECMI.sheet.skill'}}</th><th>%</th><th></th></tr></thead>
    <tbody>
      {{#each thiefSkills as |skill|}}
      <tr><th>{{skill.label}}</th><td><input name="system.thiefSkills.{{skill.key}}" type="number" value="{{skill.value}}" {{#unless ../editable}}disabled{{/unless}}></td>
        <td><button type="button" class="becmi-roll" data-action="rollThief" data-skill="{{skill.key}}">{{localize 'BECMI.rolls.skill'}}</button></td></tr>
      {{/each}}
    </tbody>
  </table>
</section>

<!-- ============================ UNDEAD ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "undead")}} is-active{{/if}}" data-tab="undead">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.turnUndead'}}</h2>
  <p class="becmi-hint">{{localize 'BECMI.sheet.turnLegend'}}</p>
  <table class="becmi-table becmi-table--undead">
    <thead><tr><th>{{localize 'BECMI.sheet.undead'}}</th>{{#each undeadColumns as |column|}}<th{{#if column.active}} class="becmi-active"{{/if}}>{{column.label}}</th>{{/each}}<th></th></tr></thead>
    <tbody>
      {{#each undeadRows as |row|}}
      <tr><th>{{row.name}}</th>
        {{#each row.cells as |cell|}}<td{{#if cell.active}} class="becmi-active"{{/if}}>{{cell.value}}</td>{{/each}}
        <td><button type="button" class="becmi-roll" data-action="rollTurnUndead" data-undead="{{row.name}}">{{localize 'BECMI.sheet.roll'}}</button></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</section>

<!-- ============================ ATTACK TABLE ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "attack")}} is-active{{/if}}" data-tab="attack">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.attackTable'}}</h2>
  <p class="becmi-hint">{{attackLabel}}</p>
  <table class="becmi-table becmi-table--attack">
    <thead><tr><th>AC</th>{{#each attackTable as |row|}}<th>{{row.ac}}</th>{{/each}}</tr></thead>
    <tbody><tr><th>{{localize 'BECMI.rolls.needed'}}</th>{{#each attackTable as |row|}}<td>{{row.needed}}</td>{{/each}}</tr></tbody>
  </table>
  <p class="becmi-hint">{{localize 'BECMI.sheet.attackLegend'}}</p>
</section>

<!-- ============================ MASTERY ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "mastery")}} is-active{{/if}}" data-tab="mastery">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.weaponMastery'}}</h2>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.useMastery'}}:</label><input name="system.mastery.enabled" type="checkbox" {{#if system.mastery.enabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}}></div>
  <p class="becmi-hint">{{localize 'BECMI.sheet.masteryChoices'}}: {{masterySpent}} / {{masteryAvailable}}</p>
  <datalist id="becmi-mastery-weapons">{{#each masteryWeapons as |name|}}<option value="{{name}}">{{name}}</option>{{/each}}</datalist>
  <table class="becmi-table becmi-table--mastery">
    <thead><tr><th>{{localize 'BECMI.sheet.weapon'}}</th><th>{{localize 'BECMI.sheet.mastery'}}</th><th>{{localize 'BECMI.sheet.primary'}}</th><th>{{localize 'BECMI.sheet.target'}}</th><th>{{localize 'BECMI.sheet.range'}}</th><th>{{localize 'BECMI.labels.damage'}}</th><th>{{localize 'BECMI.sheet.defense'}}</th><th>{{localize 'BECMI.sheet.special'}}</th><th>{{localize 'BECMI.sheet.attackBonus'}}</th><th>{{localize 'BECMI.sheet.diceVs'}}</th></tr></thead>
    <tbody>
      {{#each masteryRows as |row|}}
      <tr>
        <td><input list="becmi-mastery-weapons" name="system.mastery.rows.{{@index}}.name" type="text" value="{{row.name}}" {{#unless ../editable}}disabled{{/unless}}></td>
        <td><select name="system.mastery.rows.{{@index}}.grade" {{#unless ../editable}}disabled{{/unless}}>
          <option value="">—</option>
          {{#each ../masteryGrades as |grade|}}<option value="{{grade.key}}" {{#if (eq grade.key row.grade)}}selected{{/if}}>{{grade.nome}}</option>{{/each}}
        </select></td>
        <td><input name="system.mastery.rows.{{@index}}.primary" type="text" value="{{row.primary}}" {{#unless ../editable}}disabled{{/unless}}></td>
        <td><select name="system.mastery.rows.{{@index}}.target" {{#unless ../editable}}disabled{{/unless}}>
          <option value="prim" {{#if (eq row.target "prim")}}selected{{/if}}>{{localize 'BECMI.sheet.primary'}}</option>
          <option value="sec" {{#if (eq row.target "sec")}}selected{{/if}}>{{localize 'BECMI.sheet.secondary'}}</option>
        </select></td>
        <td>{{row.range}}</td><td>{{row.damage}}</td><td>{{row.defense}}</td><td>{{row.special}}</td><td>{{row.attack}}</td><td>{{row.dv}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  <button type="button" class="becmi-roll" data-action="addMasteryRow">{{localize 'BECMI.sheet.addRow'}}</button>
  <details>
    <summary>{{localize 'BECMI.sheet.masteryReference'}}</summary>
    <table class="becmi-table becmi-table--mastery-ref">
      <thead><tr><th>{{localize 'BECMI.sheet.weapon'}}</th><th>{{localize 'BECMI.sheet.primary'}}</th><th>{{localize 'BECMI.labels.cost'}}</th><th>{{localize 'BECMI.labels.weight'}}</th><th>{{localize 'BECMI.sheet.range'}}</th><th>{{localize 'BECMI.labels.damage'}}</th><th>{{localize 'BECMI.sheet.defense'}}</th><th>{{localize 'BECMI.sheet.special'}}</th></tr></thead>
      <tbody>
        {{#each masteryCatalog as |weapon|}}
        <tr><th>{{weapon.name}}</th><td>{{weapon.primary}}</td><td>{{weapon.cost}}</td><td>{{weapon.weight}}</td><td>{{weapon.range}}</td><td>{{weapon.damage}}</td><td>{{weapon.defense}}</td><td>{{weapon.special}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </details>
</section>

<!-- ============================ MAGIC ITEMS ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "magic")}} is-active{{/if}}" data-tab="magic">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.magicItems'}}</h2>
  <table class="becmi-table becmi-table--magic">
    <thead><tr><th>{{localize 'BECMI.sheet.equipped'}}</th><th>{{localize 'BECMI.labels.name'}}</th>CA<th>{{localize 'BECMI.labels.saveBonus'}}</th><th>{{localize 'BECMI.sheet.attackBonus'}}</th><th>{{localize 'BECMI.labels.damage'}}</th><th>{{localize 'BECMI.labels.notes'}}</th></tr></thead>
    <tbody>
      {{#each magicItems as |item|}}
      <tr>
        <td><input name="system.magicItems.{{@index}}.equipped" type="checkbox" {{#if item.equipped}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}}></td>
        <td><input name="system.magicItems.{{@index}}.name" type="text" value="{{item.name}}" {{#unless ../editable}}disabled{{/unless}}></td>
        <td><input name="system.magicItems.{{@index}}.ac" type="number" value="{{item.ac}}" {{#unless ../editable}}disabled{{/unless}}></td>
        <td><input name="system.magicItems.{{@index}}.save" type="number" value="{{item.save}}" {{#unless ../editable}}disabled{{/unless}}></td>
        <td><input name="system.magicItems.{{@index}}.attack" type="number" value="{{item.attack}}" {{#unless ../editable}}disabled{{/unless}}></td>
        <td><input name="system.magicItems.{{@index}}.damage" type="number" value="{{item.damage}}" {{#unless ../editable}}disabled{{/unless}}></td>
        <td><input name="system.magicItems.{{@index}}.notes" type="text" value="{{item.notes}}" {{#unless ../editable}}disabled{{/unless}}></td>
      </tr>
      {{/each}}
    </tbody>
    <tfoot><tr><th colspan="2">{{localize 'BECMI.sheet.magicTotals'}}</th><td>{{magicTotals.ac}}</td><td>{{magicTotals.save}}</td><td>{{magicTotals.attack}}</td><td>{{magicTotals.damage}}</td><td></td></tr></tfoot>
  </table>
</section>

<!-- ============================ NOTES ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "notes")}} is-active{{/if}}" data-tab="notes">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.notes'}}</h2>
  <textarea class="becmi-editor becmi-editor--tall" name="system.biography" {{#unless editable}}disabled{{/unless}}>{{system.biography}}</textarea>
</section>

{{else}}
<!-- ============================ MONSTER MAIN ============================ -->
<section class="becmi-tab-panel{{#if (eq activeTab "main")}} is-active{{/if}}" data-tab="main">
  <h2 class="becmi-section-title">{{localize 'BECMI.sheet.statistics'}}</h2>
  <div class="becmi-scroll-y">
    <div class="becmi-grid becmi-grid--combat">
      <div class="becmi-field"><label>{{localize 'BECMI.labels.ac'}}:</label><input name="system.ac" type="number" value="{{system.ac}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.hd'}}:</label><input name="system.hd" type="text" value="{{system.hd}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field becmi-field--hp">
        <label>{{localize 'BECMI.labels.hp'}}:</label>
        <input class="becmi-hp-current" name="system.attributes.hp.value" type="number" min="0" value="{{system.attributes.hp.value}}" title="{{localize 'BECMI.sheet.hpCurrentHint'}}">
        <span class="becmi-hp-divider">/</span>
        <input name="system.hp" type="number" min="0" value="{{system.hp}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      <div class="becmi-field becmi-field--hp-bar">
        <div class="becmi-hp-bar" role="meter" aria-valuemin="0" aria-valuemax="{{hpBar.max}}" aria-valuenow="{{hpBar.value}}"><span style="width: {{hpBar.percent}}%"></span></div>
      </div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.movement'}}:</label><span class="becmi-derived">{{system.move.dungeon}}' ({{system.move.outdoor}}')</span></div>
      <div class="becmi-field becmi-field--wide"><label>{{localize 'BECMI.labels.attacks'}}:</label><input name="system.attacks" type="text" value="{{system.attacks}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field becmi-field--wide"><label>{{localize 'BECMI.labels.damage'}}:</label><input name="system.damage" type="text" value="{{system.damage}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.appearing'}}:</label><input name="system.appearing" type="text" value="{{system.appearing}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.saveAs'}}:</label><input name="system.saveAs" type="text" value="{{system.saveAs}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.morale'}}:</label><input name="system.morale" type="number" value="{{system.morale}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.treasure'}}:</label><input name="system.treasure" type="text" value="{{system.treasure}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.intelligence'}}:</label><input name="system.intelligence" type="number" value="{{system.intelligence}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.alignment'}}:</label><input name="system.alignment" type="text" value="{{system.alignment}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.xpValue'}}:</label><input name="system.xpValue" type="number" value="{{system.xpValue}}" {{#unless editable}}disabled{{/unless}}></div>
      <button type="button" class="becmi-roll" data-action="rollMorale">{{localize 'BECMI.rolls.morale'}}</button>
      <button type="button" class="becmi-roll" data-action="rollHitDice">{{localize 'BECMI.rolls.hitDice'}}</button>
    </div>
    <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.savingThrows'}} <small>{{system.saveAs}}</small></h3>
    <table class="becmi-table becmi-table--saves">
      <thead><tr><th>{{localize 'BECMI.sheet.skill'}}</th><th>{{localize 'BECMI.labels.saveTarget'}}</th><th></th></tr></thead>
      <tbody>
        {{#each saveRows as |save|}}
        <tr>
          <th>{{save.label}}</th>
          <td class="becmi-derived">{{save.target}}</td>
          <td><button type="button" class="becmi-roll" data-action="rollSave" data-save="{{save.key}}">{{localize 'BECMI.sheet.roll'}}</button></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.monsterAttacks'}}</h3>
    <div class="becmi-monster-attacks">
      {{#each monsterAttacks as |attack|}}
      <button type="button" class="becmi-roll becmi-monster-attack" data-action="monsterAttack" data-attack-index="{{attack.index}}" title="{{localize 'BECMI.sheet.rollAttackAndDamage'}}">
        <strong>{{attack.name}}</strong>{{#if attack.damage}} <span>{{attack.damage}}</span>{{/if}}{{#if attack.note}} <small>{{attack.note}}</small>{{/if}}
      </button>
      {{else}}
      <p class="becmi-empty">{{localize 'BECMI.sheet.noMonsterAttacks'}}</p>
      {{/each}}
    </div>
    <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.classification'}}</h3>
    <div class="becmi-grid becmi-grid--combat">
      <div class="becmi-field becmi-field--wide"><label>{{localize 'BECMI.labels.monsterType'}}:</label><input name="system.monsterType" type="text" value="{{system.monsterType}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.terrain'}}:</label><input name="system.terrain" type="text" value="{{system.terrain}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.source'}}:</label><span class="becmi-derived">{{system.source}}</span></div>
      <div class="becmi-field"><label>{{localize 'BECMI.labels.page'}}:</label><span class="becmi-derived">{{system.page}}</span></div>
    </div>
  </div>
</section>

<section class="becmi-tab-panel{{#if (eq activeTab "notes")}} is-active{{/if}}" data-tab="notes">
  <div class="becmi-scroll-y">
    <h2 class="becmi-section-title">{{localize 'BECMI.labels.description'}}</h2>
    <div class="becmi-editor">{{{system.description}}}</div>
    {{#if system.special}}<h2 class="becmi-section-title">{{localize 'BECMI.sheet.special'}}</h2><div class="becmi-editor">{{{system.special}}}</div>{{/if}}
    <h2 class="becmi-section-title">{{localize 'BECMI.labels.notes'}}</h2>
    <div class="becmi-editor">{{{system.notes}}}</div>
  </div>
</section>
{{/if}}

</div>

<!-- ============================ SIDEBAR ============================ -->
<aside class="becmi-sidebar" aria-label="{{localize 'BECMI.sheet.sidebar.title'}}">
  <div class="becmi-section-title">{{localize 'BECMI.sheet.sidebar.title'}}
    <button type="button" class="becmi-roll" data-action="toggleSidebar">×</button>
  </div>

  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.sidebar.quickRolls'}}</h3>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.targetAC'}}:</label><input data-target-ac type="number" value="{{targetAC}}" min="-10" max="20"></div>
  <div class="becmi-sidebar-roll">
    <input type="text" data-roll-expression value="1d20" aria-label="{{localize 'BECMI.sheet.expression'}}">
    <button type="button" class="becmi-roll" data-action="rollFree">{{localize 'BECMI.sheet.roll'}}</button>
  </div>
  <div class="becmi-sidebar-dice">
    {{#each diceOptions as |die|}}
    <button type="button" class="becmi-roll" data-action="rollDice" data-dice="{{die.faces}}">d{{die.faces}}</button>
    {{/each}}
  </div>

  {{#if isCharacter}}
  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.sidebar.classInfo'}}</h3>
  <p class="becmi-hint">{{className}}</p>
  {{#each classResources as |resource|}}
  <p class="becmi-hint">{{resource.label}}</p>
  {{/each}}
  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.sidebar.abilities'}}</h3>
  <div class="becmi-scroll-y becmi-feature-list">
    {{#each classFeatures as |feature|}}
    <p class="becmi-hint"><strong>{{feature.label}}</strong>{{#if feature.unlocked}} ✓{{else}} ({{feature.requirement}}){{/if}} — {{feature.detail}}</p>
    {{else}}
    <p class="becmi-hint">{{localize 'BECMI.sheet.noFeatures'}}</p>
    {{/each}}
  </div>
  {{#if classKey}}
  {{#if (eq classKey "cleric")}}
  <button type="button" class="becmi-roll" data-action="toggleDruid">
    {{#if isDruid}}{{localize 'BECMI.sheet.druidDisable'}}{{else}}{{localize 'BECMI.sheet.druidEnable'}}{{/if}}
  </button>
  {{/if}}
  {{/if}}
  {{#each milestones as |milestone|}}
  <p class="becmi-hint">• {{milestone}}</p>
  {{/each}}

  <h3 class="becmi-subtitle">{{localize 'BECMI.labels.languages'}}</h3>
  <input name="system.languages" type="text" value="{{system.languages}}" {{#unless editable}}disabled{{/unless}}>
  <h3 class="becmi-subtitle">{{localize 'BECMI.labels.specialAbilities'}}</h3>
  <textarea class="becmi-editor" name="system.specialAbilities" {{#unless editable}}disabled{{/unless}}>{{system.specialAbilities}}</textarea>
  {{/if}}

  <h3 class="becmi-subtitle">{{localize 'BECMI.sheet.sidebar.reference'}}</h3>
  <div class="becmi-sidebar-links">
    <button type="button" class="becmi-roll" data-action="switchTab" data-tab="attack">{{localize 'BECMI.sheet.tab.attack'}}</button>
    {{#if canTurn}}<button type="button" class="becmi-roll" data-action="switchTab" data-tab="undead">{{localize 'BECMI.sheet.tab.undead'}}</button>{{/if}}
    {{#if canMastery}}<button type="button" class="becmi-roll" data-action="switchTab" data-tab="mastery">{{localize 'BECMI.sheet.tab.mastery'}}</button>{{/if}}
    <button type="button" class="becmi-roll" data-action="switchTab" data-tab="notes">{{localize 'BECMI.sheet.tab.notes'}}</button>
  </div>
</aside>
</div>
</div>
