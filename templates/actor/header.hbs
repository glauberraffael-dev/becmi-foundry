<header class="becmi-sheet-header">
  <img class="becmi-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="{{actor.name}}">
  <div class="becmi-title-block">
    <h1 class="becmi-sheet-title">D&amp;D BECMI - Character Sheet</h1>
    <div class="becmi-top-fields">
      <div class="becmi-field becmi-field--wide">
        <label>{{localize 'BECMI.labels.characterName'}}</label>
        <input name="name" type="text" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      <div class="becmi-field">
        <label>{{localize 'BECMI.labels.level'}}</label>
        <input name="system.attributes.level" type="number" value="{{system.attributes.level}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      <div class="becmi-field">
        <label>{{localize 'BECMI.labels.player'}}</label>
        <input name="system.attributes.player" type="text" value="{{system.attributes.player}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      {{#if isCharacter}}
      <div class="becmi-field">
        <label>{{localize 'BECMI.labels.rcClass'}}</label>
        <select data-action="setClass" {{#unless editable}}disabled{{/unless}}>
          <option value="">—</option>
          {{#each classOptions as |option|}}
          <option value="{{option.key}}" {{#if (eq option.key ../classKey)}}selected{{/if}}>{{option.name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="becmi-field">
        <label>{{localize 'BECMI.labels.alignment'}}</label>
        <input name="system.attributes.alignment" type="text" value="{{system.attributes.alignment}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      <div class="becmi-field">
        <label>{{localize 'BECMI.labels.currentXp'}}</label>
        <input name="system.attributes.xp" type="number" value="{{system.attributes.xp}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      <div class="becmi-field becmi-field--wide">
        <label>{{localize 'BECMI.labels.nextLevelXp'}}</label>
        <input name="system.attributes.xpNext" type="number" value="{{system.attributes.xpNext}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      {{else}}
      <div class="becmi-field becmi-field--wide">
        <label>{{localize 'BECMI.labels.monsterType'}}:</label>
        <span class="becmi-derived">{{system.monsterType}}</span>
      </div>
      {{/if}}
    </div>
  </div>
</header>
