<header class="becmi-header">
  <div class="becmi-image-wrap">
    <img class="becmi-avatar" src="{{item.img}}" alt="{{item.name}}">
    <button type="button" class="becmi-image-edit" data-action="editImage" data-field="img" data-edit="img" title="{{localize 'BECMI.sheet.editImage'}}" aria-label="{{localize 'BECMI.sheet.editImage'}}" {{#unless editable}}disabled{{/unless}}>✎</button>
  </div>
  <div class="becmi-header-fields">
    <div class="becmi-field becmi-field--name">
      <input name="name" type="text" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
    </div>
    <div class="becmi-field">
      <label>{{localize 'BECMI.labels.source'}}</label>
      <input name="system.source" type="text" value="{{system.source}}" {{#unless editable}}disabled{{/unless}}>
    </div>
    <div class="becmi-field">
      <label>{{localize 'BECMI.labels.page'}}</label>
      <input name="system.page" type="number" value="{{system.page}}" {{#unless editable}}disabled{{/unless}}>
    </div>
  </div>
</header>
