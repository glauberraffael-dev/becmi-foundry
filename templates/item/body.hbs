<div class="becmi-section-title">{{localize 'BECMI.sheet.details'}}</div>
<div class="becmi-grid becmi-grid--combat">
  {{#if isWeapon}}
  <div class="becmi-field"><label>{{localize 'BECMI.labels.damage'}}</label><input name="system.damage" type="text" value="{{system.damage}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.attackBonus'}}</label><input name="system.attackBonus" type="number" value="{{system.attackBonus}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.range'}}</label><input name="system.range" type="number" value="{{system.range}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.attacksPerRound'}}</label><input name="system.rate" type="number" value="{{system.rate}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.cost'}}</label><input name="system.cost" type="text" value="{{system.cost}}" {{#unless editable}}disabled{{/unless}}></div>
  <button type="button" data-action="rollAttack">{{localize 'BECMI.rolls.attack'}}</button>
  <button type="button" data-action="rollDamage">{{localize 'BECMI.rolls.damage'}}</button>
  {{else if isSpell}}
  <div class="becmi-field"><label>{{localize 'BECMI.labels.spellLevel'}}</label><input name="system.spellLevel" type="number" value="{{system.spellLevel}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.range'}}</label><input name="system.range" type="text" value="{{system.range}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.duration'}}</label><input name="system.duration" type="text" value="{{system.duration}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.effect'}}</label><input name="system.effect" type="text" value="{{system.effect}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.spellLists'}}</label><input name="system.spellLists" type="text" value="{{system.spellLists}}" {{#unless editable}}disabled{{/unless}}></div>
  {{else if isArmor}}
  <div class="becmi-field"><label>{{localize 'BECMI.labels.ac'}}</label><input name="system.ac" type="number" value="{{system.ac}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.cost'}}</label><input name="system.cost" type="text" value="{{system.cost}}" {{#unless editable}}disabled{{/unless}}></div>
  {{else if isClass}}
  <div class="becmi-field"><label>{{localize 'BECMI.labels.primeRequisite'}}</label><input name="system.primeRequisite" type="text" value="{{system.primeRequisite}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.hd'}}</label><input name="system.hitDice" type="text" value="{{system.hitDice}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.level'}}</label><input name="system.maxLevel" type="number" value="{{system.maxLevel}}" {{#unless editable}}disabled{{/unless}}></div>
  {{else}}
  <div class="becmi-field"><label>{{localize 'BECMI.labels.cost'}}</label><input name="system.cost" type="text" value="{{system.cost}}" {{#unless editable}}disabled{{/unless}}></div>
  <div class="becmi-field"><label>{{localize 'BECMI.labels.quantity'}}</label><input name="system.quantity" type="number" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}}></div>
  {{/if}}
</div>

<div class="becmi-section-title">{{localize 'BECMI.labels.description'}}</div>
<textarea class="becmi-editor" name="system.description" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
{{#if item.actor}}
<div class="becmi-section-title">{{localize 'BECMI.sheet.notes'}}</div>
<button type="button" data-action="sendToChat">{{localize 'BECMI.sheet.sendToChat'}}</button>
{{/if}}
